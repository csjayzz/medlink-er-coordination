rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── medlinkAlerts ────────────────────────────────────────
    match /medlinkAlerts/{alertId} {
      // Medics can create new alerts
      allow create: if request.auth != null
                    && request.auth.token.role == 'medic';

      // Hospital role can read all alerts; medics can read their own
      allow read: if request.auth != null
                  && (request.auth.token.role == 'hospital'
                      || request.auth.uid == resource.data.medicId);

      // Hospital role or the alert's own medic can update
      allow update: if request.auth != null
                    && (request.auth.token.role == 'hospital'
                        || request.auth.uid == resource.data.medicId);

      // Nobody deletes — Cloud Function handles TTL cleanup
      allow delete: if false;
    }

    // ── auditLogs ────────────────────────────────────────────
    match /auditLogs/{logId} {
      // Any authenticated user can create audit entries
      allow create: if request.auth != null;

      // Only hospital staff can read audit logs
      allow read: if request.auth != null
                  && request.auth.token.role == 'hospital';

      // No updates or deletes — audit logs are immutable
      allow update: if false;
      allow delete: if false;
    }
  }
}

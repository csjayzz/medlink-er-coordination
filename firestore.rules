rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /medlinkAlerts/{alertId} {
      // Demo-friendly rules: any signed-in user can participate in the alert flow.
      // This matches the current app auth fallback, which does not reliably provide
      // Firebase custom claims for every user.
      allow create: if request.auth != null
                    && request.resource.data.medicId == request.auth.uid;

      allow read: if request.auth != null;

      allow update: if request.auth != null
                    && (
                      request.auth.uid == resource.data.medicId
                      || request.resource.data.medicId == resource.data.medicId
                    );

      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /hospitalBeds/{bedId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /hospitalStaff/{staffId} {
      allow read, create, update, delete: if request.auth != null;
    }
  }
}
